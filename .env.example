# ---------------------------------------------------------------------------
# lendyph-frontend environment
#
# EVERY value here is inlined into the JavaScript bundle at BUILD time. Editing
# this file on a deployed box does nothing until `npm run build` runs again.
#
# One codebase serves several deployments (portfolio, lendy.ph, binhs-coop —
# each with prod and staging). They differ ONLY by the values in this file, so
# the four vars marked REQUIRED must be set per deployment; their code defaults
# are localhost values that exist for local development and are wrong anywhere
# else. `npm run build` refuses to start if one is missing.
# ---------------------------------------------------------------------------

# --- REQUIRED per deployment ------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_STORAGE_URL=http://localhost:8000/storage

# --- Universal: same on every deployment ------------------------------------
NEXT_PUBLIC_APP_NAME=Lendy.PH
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_AUTH_TOKEN_KEY=lendy_access_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=lendy_refresh_token
NEXT_PUBLIC_SESSION_TIMEOUT=30
NEXT_PUBLIC_CURRENCY=PHP
NEXT_PUBLIC_CURRENCY_SYMBOL=₱
NEXT_PUBLIC_TAX_RATE=12
NEXT_PUBLIC_TIMEZONE=Asia/Manila

# --- Feature flags ----------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Client-specific: the BINHS amortization calculator. On for binhs-coop only.
NEXT_PUBLIC_ENABLE_BINHS_AMORTIZATION=false

# --- Debug: leave false on anything deployed --------------------------------
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_SHOW_ERROR_DETAILS=false
NEXT_PUBLIC_MOCK_API=false
