# ---------------------------------------------------------------------------
# Playwright e2e suite (`npm run test:e2e`) — NOT a build input.
#
# Nothing here is NEXT_PUBLIC_*, so nothing here is inlined into the bundle;
# these are read at test time only. Keep them out of .env / .env.example, which
# are the BUILD contract (see scripts/check-env.mjs).
#
# Copy to `.env.e2e.local` — gitignored via `.env*.local` — and fill it in, or
# export the three vars. A real environment variable always wins over this file.
#
# With E2E_USERNAME / E2E_PASSWORD unset the suite SKIPS with a stated reason
# instead of failing, so it is safe to run with no secrets at all.
# ---------------------------------------------------------------------------

# Deployment under test. STAGING OR LOCAL ONLY — the config refuses to run
# against any host that is not localhost and does not contain "staging".
# Defaults to the value below when unset.
E2E_BASE_URL=https://binhs-coop-staging.lendyph.com

# An account that holds `fees:view`. Every fees:* permission is admin-only
# (src/constants/rbac.ts), so in practice this must be an admin — any other
# role lands on the AccessDenied screen. The account must not be flagged
# must_change_password: the API answers 423 to everything until it is cleared.
E2E_USERNAME=
E2E_PASSWORD=
