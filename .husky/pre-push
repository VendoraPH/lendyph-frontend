#!/bin/sh

echo "🔍 Running pre-push checks..."

# Pull latest development into the current branch before pushing
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$CURRENT_BRANCH" != "development" ] && [ "$CURRENT_BRANCH" != "main" ]; then
  echo "🔄 Pulling latest development into $CURRENT_BRANCH..."
  git fetch origin development
  if ! git rebase origin/development; then
    echo "❌ Rebase onto development failed. Resolve conflicts and try again."
    git rebase --abort
    exit 1
  fi
  echo "✅ Branch is up-to-date with development."
fi

echo "📝 TypeScript check..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript check failed. Push aborted."
  exit 1
fi

echo "🏗️ Build check..."
npm run build
if [ $? -ne 0 ]; then
  echo "❌ Build failed. Push aborted."
  exit 1
fi

echo "✅ All checks passed. Pushing..."
